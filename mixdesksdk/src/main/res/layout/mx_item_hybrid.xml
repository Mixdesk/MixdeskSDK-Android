<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root_ll"
    style="@style/MQMatchMatch.Horizontal"
    android:padding="8dp">

    <com.mixdesk.mixdesksdk.widget.MXImageView
        android:id="@+id/iv_robot_avatar"
        android:layout_width="35dp"
        android:layout_height="35dp"
        android:layout_marginRight="6dp"
        android:src="@drawable/mx_ic_holder_avatar"
        app:mx_iv_isCircle="true"
        tools:background="#f00" />

    <LinearLayout
        android:id="@+id/ll_root_robot_container"
        android:layout_width="wrap_content"
        android:orientation="vertical"
        android:layout_height="wrap_content" >
        <LinearLayout
            android:id="@+id/ll_hybrid_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- 访客发送的 hybrid（商品卡片）：发送中 / 失败状态，在卡片左侧 -->
            <ProgressBar
                android:id="@+id/hybrid_progress_bar"
                android:layout_width="20dp"
                android:layout_height="15dp"
                android:layout_marginRight="5dp"
                android:indeterminate="false"
                android:indeterminateDrawable="@drawable/mx_loading"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/hybrid_send_state"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginRight="5dp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/ll_robot_container"
                android:layout_width="240dp"
                android:layout_height="wrap_content"
                android:background="@drawable/mx_bg_msg_left"
                android:orientation="vertical">

            </LinearLayout>
        </LinearLayout>

        <com.mixdesk.mixdesksdk.widget.MXWarpLinearLayout
            android:id="@+id/ll_operation"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>
</LinearLayout>