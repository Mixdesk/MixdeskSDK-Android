<?xml version="1.0" encoding="utf-8"?>
<!-- 商品卡片：左 72dp 方图（无图时隐藏），右侧名称 2 行、价格、描述 1 行；旧数据有 sales_count 时显示销量 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="10dp">

    <ImageView
        android:id="@+id/mx_pic_iv"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_marginRight="10dp"
        android:scaleType="centerCrop"
        tools:src="@drawable/mx_ic_holder_light" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/mx_title_tv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/mx_activity_title_textColor"
            android:textSize="14sp"
            tools:text="真皮通勤托特包 大容量 可放 14 寸笔记本 超长名称省略" />

        <TextView
            android:id="@+id/mx_price_tv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/mx_error_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="¥599.00"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/mx_desc_tv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:alpha="0.6"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/mx_activity_title_textColor"
            android:textSize="12sp"
            android:visibility="gone"
            tools:text="头层牛皮，可放 14 寸笔记本"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/count_tv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:alpha="0.6"
            android:maxLines="1"
            android:textColor="@color/mx_activity_title_textColor"
            android:textSize="11sp"
            android:visibility="gone"
            tools:text="销量：111" />
    </LinearLayout>
</LinearLayout>
